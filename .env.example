# ==============================================================================
# QueueFlow — Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to .env and configure values for your environment.
# Never commit real credentials or .env files to version control.
# ==============================================================================

# Server Runtime Configuration
NODE_ENV=development
PORT=5000

# Persistence (MongoDB Connection String)
MONGO_URI=mongodb://localhost:27017/queueflow

# Authentication & Session Security (Must be at least 32 characters in production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_characters

# Client Origin (CORS & Cookie Domain Validation)
CLIENT_URL=http://localhost:5173

# Business Operating Rules & Timezone
# Authoritative timezone for business calendar, slot calculations, and daily sequence resets
BUSINESS_TIMEZONE=UTC

# Initial Administrative Seed Credentials (Used by `npm run seed:admin`)
ADMIN_EMAIL=admin@queueflow.com
ADMIN_INITIAL_PASSWORD=ChangeMeAdmin123!

# Frontend Client Configuration (Vite)
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
